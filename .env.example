# ====================================
# Application Configuration
# ====================================
ENVIRONMENT=development
DEBUG=True
APP_NAME="Capital Guard - Portfolio Optimization & Risk Control Platform"
PORT=8000
HOST=0.0.0.0

# ====================================
# CORS Settings
# ====================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ====================================
# Supabase Configuration
# ====================================
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL connection string for SQLAlchemy (found under Project Settings -> Database -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ====================================
# Financial Data APIs
# ====================================
FRED_API_KEY=your_fred_api_key_here

# Local Data Cache Settings
ENABLE_DATA_CACHE=True
CACHE_EXPIRY_HOURS=24
